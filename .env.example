# ─── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_DB=manga_translator
POSTGRES_USER=manga
# OBRIGATÓRIO — defina antes de subir os containers
POSTGRES_PASSWORD=changeme

# ─── Backend ───────────────────────────────────────────────────────────────────
# Porta exposta pelo backend no host
BACKEND_PORT=8000

# Chave secreta usada para assinar tokens (mude em produção)
SECRET_KEY=changeme-secret-key

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Limite de confiança do OCR abaixo do qual o bloco fica NEEDS_REVIEW (0–1)
OCR_LOW_CONFIDENCE_THRESHOLD=0.80

# Política ao exportar JSON com blocos NEEDS_REVIEW: block | warn | ignore
EXPORT_BLOCK_ON_LOW_CONFIDENCE=warn

# Diretório interno do container onde as imagens são armazenadas
MEDIA_ROOT=/app/media

# ─── Redis / fila ──────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Frontend ──────────────────────────────────────────────────────────────────
# Porta exposta pelo frontend no host
FRONTEND_PORT=4200

# URL base da API consumida pelo Angular (build-time)
API_BASE_URL=http://localhost:8000
